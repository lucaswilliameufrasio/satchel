              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change received"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes received"
                }
              }
            }
          }
        },
        "pt-BR": {
